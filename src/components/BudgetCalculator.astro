---
// BudgetCalculator.astro
import { BUDGET_BREAKDOWN, TRIP_META } from '../data/tripData';

const totalCost = BUDGET_BREAKDOWN.reduce((acc, item) => acc + item.total, 0);
const perPersonCost = totalCost / TRIP_META.participants;
const percentUsed = Math.round((perPersonCost / TRIP_META.maxBudgetPerPerson) * 100);
---

<div class="rounded-3xl bg-surface/85 backdrop-blur-2xl border border-white/10 p-6 sm:p-8 shadow-2xl relative overflow-hidden">
  
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-white/10">
    <div>
      <span class="text-xs uppercase font-extrabold tracking-widest text-emerald-400">Presupuesto Real Ajustado</span>
      <h3 class="text-2xl sm:text-3xl font-black text-white tracking-tight mt-1">
        4 Personas en Coche + Tienda de Campaña
      </h3>
      <p class="text-xs sm:text-sm text-slate-400 mt-1 max-w-xl">
        Calculado con tarifas oficiales reales de camping en Torla (temporada de otoño) y combustible con consumo medio en autovía y montaña.
      </p>
    </div>

    <!-- Apple Health style progress box -->
    <div class="bg-surface-elevated/90 border border-white/10 p-4 rounded-2xl flex items-center gap-5 shrink-0">
      <div class="relative w-16 h-16 flex items-center justify-center">
        <!-- SVG circle progress -->
        <svg class="w-16 h-16 transform -rotate-90" viewBox="0 0 36 36">
          <path
            class="text-white/10"
            stroke-width="3.5"
            stroke="currentColor"
            fill="none"
            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
          />
          <path
            class="text-emerald-400"
            stroke-dasharray={`${percentUsed}, 100`}
            stroke-width="3.5"
            stroke-linecap="round"
            stroke="currentColor"
            fill="none"
            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
          />
        </svg>
        <span class="absolute font-black text-xs text-white">{percentUsed}%</span>
      </div>

      <div>
        <div class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Coste Estimado</div>
        <div class="text-2xl font-black text-emerald-400">~{perPersonCost.toFixed(2)} €</div>
        <div class="text-[11px] text-slate-300">
          de <span class="line-through text-slate-500">{TRIP_META.maxBudgetPerPerson} €</span> de límite
        </div>
      </div>
    </div>
  </div>

  <!-- Breakdown Table -->
  <div class="mt-6 overflow-x-auto">
    <table class="w-full text-left text-xs">
      <thead>
        <tr class="border-b border-white/10 text-slate-400 uppercase text-[10px] tracking-wider">
          <th class="pb-3 font-bold">Concepto</th>
          <th class="pb-3 font-bold">Detalle y Tarifas</th>
          <th class="pb-3 font-bold text-right">Total Grupo</th>
          <th class="pb-3 font-bold text-right text-emerald-400">Por Persona</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        {BUDGET_BREAKDOWN.map(item => (
          <tr class="group hover:bg-white/5 transition-colors">
            <td class="py-3.5 font-bold text-white flex items-center gap-2">
              <span class="text-base">
                {item.category === 'transporte' ? '⛽' : item.category === 'alojamiento' ? '⛺' : '🎟️'}
              </span>
              <span>{item.concept}</span>
            </td>
            <td class="py-3.5 text-slate-400 max-w-xs">{item.note}</td>
            <td class="py-3.5 text-right font-mono font-medium text-slate-300">{item.total.toFixed(2)} €</td>
            <td class="py-3.5 text-right font-mono font-bold text-emerald-400 text-sm">{item.perPerson.toFixed(2)} €</td>
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr class="border-t-2 border-white/15 text-sm font-extrabold">
          <td class="pt-4 text-white">TOTAL ESTIMADO</td>
          <td class="pt-4 text-xs text-slate-400 font-normal">Todo incluido (Combustible + Camping 4 noches + Bus)</td>
          <td class="pt-4 text-right font-mono text-white">{totalCost.toFixed(2)} €</td>
          <td class="pt-4 text-right font-mono text-emerald-400 text-base">~{perPersonCost.toFixed(2)} €</td>
        </tr>
      </tfoot>
    </table>
  </div>

  <!-- Savings Banner -->
  <div class="mt-6 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
    <div class="flex items-center gap-2.5 text-emerald-200">
      <span class="text-xl">💰</span>
      <span>
        <strong>¡Margen de seguridad de {(TRIP_META.maxBudgetPerPerson - perPersonCost).toFixed(2)} € por persona!</strong> 
        Os queda presupuesto de sobra para comida, meriendas o una buena comida de chuletón en Broto.
      </span>
    </div>
  </div>
</div>
