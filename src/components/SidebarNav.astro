---
// src/components/SidebarNav.astro
---

<aside class="w-16 sm:w-[68px] h-screen bg-[#0e1217] border-r border-white/10 flex flex-col items-center justify-between py-4 z-40 shrink-0 select-none shadow-2xl">
  <!-- Top: Logo -->
  <div class="flex flex-col items-center gap-4">
    <button 
      id="btn-nav-home" 
      class="group relative flex items-center justify-center w-11 h-11 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 text-white shadow-lg shadow-orange-500/20 hover:scale-105 active:scale-95 transition-all"
      title="Pirineos 2026"
    >
      <span class="text-xl">🏔️</span>
      <span class="absolute left-full ml-3 px-2.5 py-1 rounded-lg bg-[#1a2030] text-xs font-semibold text-white whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-xl border border-white/10 z-50">
        Pirineos 2026
      </span>
    </button>

    <div class="w-8 h-[1px] bg-white/10 my-1"></div>

    <nav class="flex flex-col items-center gap-2">
      <!-- 1. RUTA (resumen simplificado) — Active by default -->
      <button 
        id="btn-nav-ruta"
        class="nav-tab-btn group relative flex flex-col items-center justify-center w-11 h-11 rounded-2xl text-amber-400 bg-white/10 border border-amber-500/30 transition-all hover:bg-white/15"
        data-panel="ruta"
        title="Resumen de Ruta"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
        </svg>
        <span class="text-[9px] font-bold mt-0.5 tracking-tight">Ruta</span>
        <span class="absolute left-full ml-3 px-2.5 py-1 rounded-lg bg-[#1a2030] text-xs font-medium text-white whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-xl border border-white/10 z-50">
          Resumen de Ruta
        </span>
      </button>

      <!-- 2. ITINERARIO (detallado hora a hora) -->
      <button 
        id="btn-nav-itinerario"
        class="nav-tab-btn group relative flex flex-col items-center justify-center w-11 h-11 rounded-2xl text-slate-400 hover:text-white hover:bg-white/10 transition-all"
        data-panel="itinerario"
        title="Itinerario Detallado"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
        </svg>
        <span class="text-[9px] font-medium mt-0.5 tracking-tight">Itinerario</span>
        <span class="absolute left-full ml-3 px-2.5 py-1 rounded-lg bg-[#1a2030] text-xs font-medium text-white whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-xl border border-white/10 z-50">
          Itinerario Hora a Hora
        </span>
      </button>

      <!-- 3. Equipo -->
      <button 
        id="btn-nav-gear"
        class="nav-tab-btn group relative flex flex-col items-center justify-center w-11 h-11 rounded-2xl text-slate-400 hover:text-white hover:bg-white/10 transition-all"
        title="Material y Equipo"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <span class="text-[9px] font-medium mt-0.5 tracking-tight">Equipo</span>
        <span class="absolute left-full ml-3 px-2.5 py-1 rounded-lg bg-[#1a2030] text-xs font-medium text-white whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-xl border border-white/10 z-50">
          Checklist de Material
        </span>
      </button>

      <!-- 4. Gastos -->
      <button 
        id="btn-nav-budget"
        class="nav-tab-btn group relative flex flex-col items-center justify-center w-11 h-11 rounded-2xl text-slate-400 hover:text-white hover:bg-white/10 transition-all"
        title="Presupuesto"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-[9px] font-medium mt-0.5 tracking-tight">Gastos</span>
        <span class="absolute left-full ml-3 px-2.5 py-1 rounded-lg bg-[#1a2030] text-xs font-medium text-white whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-xl border border-white/10 z-50">
          Presupuesto
        </span>
      </button>
    </nav>
  </div>

  <!-- Bottom -->
  <div class="flex flex-col items-center gap-3">
    <div class="group relative flex items-center justify-center w-10 h-10 rounded-2xl bg-white/5 border border-white/10 cursor-pointer transition-all">
      <span class="text-sm">👥</span>
      <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-emerald-500 text-[10px] font-black text-obsidian flex items-center justify-center">4</span>
      <span class="absolute left-full ml-3 px-2.5 py-1 rounded-lg bg-[#1a2030] text-xs font-medium text-white whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-xl border border-white/10 z-50">
        4 Amigos · Coche Valencia
      </span>
    </div>
    <a href="tel:112" class="group relative flex items-center justify-center w-10 h-10 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-400 hover:bg-red-500/20 transition-all" title="112">
      <span class="text-xs font-black">112</span>
      <span class="absolute left-full ml-3 px-2.5 py-1 rounded-lg bg-[#1a2030] text-xs font-medium text-red-300 whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-xl border border-red-500/20 z-50">
        Emergencias: 112
      </span>
    </a>
  </div>
</aside>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btnRuta = document.getElementById('btn-nav-ruta');
    const btnItinerario = document.getElementById('btn-nav-itinerario');
    const btnGear = document.getElementById('btn-nav-gear');
    const btnBudget = document.getElementById('btn-nav-budget');
    const btnHome = document.getElementById('btn-nav-home');

    // Activar tab visual
    function activateTab(activeBtn) {
      document.querySelectorAll('.nav-tab-btn').forEach(btn => {
        btn.classList.remove('text-amber-400', 'bg-white/10', 'border-amber-500/30');
        btn.classList.add('text-slate-400');
      });
      activeBtn.classList.add('text-amber-400', 'bg-white/10', 'border-amber-500/30');
      activeBtn.classList.remove('text-slate-400');
    }

    btnRuta?.addEventListener('click', () => {
      activateTab(btnRuta);
      window.dispatchEvent(new CustomEvent('switch-panel', { detail: { panel: 'ruta' } }));
    });

    btnItinerario?.addEventListener('click', () => {
      activateTab(btnItinerario);
      window.dispatchEvent(new CustomEvent('switch-panel', { detail: { panel: 'itinerario' } }));
    });

    btnHome?.addEventListener('click', () => {
      activateTab(btnRuta);
      window.dispatchEvent(new CustomEvent('switch-panel', { detail: { panel: 'ruta' } }));
      window.dispatchEvent(new CustomEvent('select-day', { detail: { dayId: 'all' } }));
    });

    btnGear?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-gear-modal'));
    });

    btnBudget?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-budget-modal'));
    });
  });
</script>
