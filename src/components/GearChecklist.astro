---
// GearChecklist.astro
import { GEAR_CHECKLIST } from '../data/tripData';
---

<div class="rounded-3xl bg-surface/85 backdrop-blur-2xl border border-white/10 p-6 sm:p-8 shadow-2xl relative">
  <div class="flex items-center justify-between gap-4 mb-6">
    <div>
      <span class="text-xs uppercase font-extrabold tracking-widest text-accent">Checklist Oficial de Montaña</span>
      <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight mt-0.5">
        ¿Qué metemos en la mochila y el maletero?
      </h3>
      <p class="text-xs text-slate-400 mt-1">
        Las noches de octubre en el Pirineo rondan los 4°C - 7°C. La Senda de los Cazadores requiere frontal cargado.
      </p>
    </div>
    
    <span class="text-2xl">🎒</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3" id="gear-list">
    {GEAR_CHECKLIST.map((gear, idx) => (
      <label class="group flex items-start gap-3 p-3.5 rounded-2xl bg-surface-elevated/70 border border-white/5 hover:border-white/15 cursor-pointer transition-all">
        <input 
          type="checkbox" 
          id={`gear-item-${idx}`}
          class="mt-1 w-4 h-4 rounded text-accent bg-black/40 border-white/20 focus:ring-accent focus:ring-offset-0 cursor-pointer"
        />
        <div class="flex-1 text-xs">
          <div class="flex items-center gap-1.5 font-bold text-slate-200 group-hover:text-white">
            <span>{gear.item}</span>
            {gear.critical && (
              <span class="text-[9px] uppercase px-1.5 py-0.2 rounded-md bg-red-500/20 text-red-300 border border-red-500/30">
                Crítico
              </span>
            )}
          </div>
          <p class="text-[11px] text-slate-400 mt-0.5">{gear.note}</p>
        </div>
      </label>
    ))}
  </div>
</div>
