---
// src/components/InteractiveMap.astro
import { TRIP_DAYS, MAP_PINS, REFUGIO_PINS } from '../data/tripData';
---

<div class="relative w-full h-full flex-1 overflow-hidden select-none">
  <!-- Top-Right Layer & Center Controls -->
  <div class="absolute top-4 right-4 z-20 flex items-center gap-2 pointer-events-auto">
    <button 
      id="btn-toggle-layer" 
      class="px-3 py-1.5 rounded-xl bg-[#111620]/90 backdrop-blur-md border border-white/15 text-slate-300 hover:text-white text-xs font-semibold shadow-lg transition-all hover:bg-white/15"
    >
      🛰️ Satélite
    </button>
    <button 
      id="btn-recenter-map" 
      class="w-8 h-8 rounded-xl bg-[#111620]/90 backdrop-blur-md border border-white/15 text-slate-300 hover:text-white text-xs flex items-center justify-center shadow-lg transition-all hover:bg-white/15"
      title="Vista general del viaje"
    >
      🎯
    </button>
  </div>

  <!-- Legend in Map (Bottom-Right, subtle) -->
  <div class="hidden sm:flex absolute bottom-5 right-5 z-20 bg-[#111620]/90 backdrop-blur-md border border-white/15 rounded-2xl px-3.5 py-2 text-[11px] items-center gap-3.5 text-slate-300 shadow-xl pointer-events-none">
    <div class="flex items-center gap-1.5">
      <span class="inline-flex w-4 h-1.5 rounded-full bg-sky-400 shadow-[0_0_8px_#38bdf8] relative overflow-hidden">
        <span class="absolute inset-0 bg-white/70 animate-pulse"></span>
      </span>
      <span>En coche (flujo animado)</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="w-3.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]"></span>
      <span>A pie (sendero)</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span>🛖</span>
      <span>Refugio</span>
    </div>
    <div class="flex items-center gap-1 border-l border-white/15 pl-2.5 text-slate-400">
      <span class="w-4 h-4 rounded-full bg-white/15 text-slate-200 font-bold text-[9px] flex items-center justify-center">1</span>
      <span class="text-[10px]">➔</span>
      <span class="w-4 h-4 rounded-full bg-white/15 text-slate-200 font-bold text-[9px] flex items-center justify-center">5</span>
      <span class="text-[10px] ml-0.5">Etapas</span>
    </div>
  </div>

  <!-- Leaflet Map Canvas -->
  <div id="full-trip-map" class="w-full h-full bg-[#0a0d12] z-0"></div>

  <!-- Floating POI Detail Card (Bottom-Left) -->
  <div 
    id="poi-detail-card" 
    class="absolute bottom-5 left-5 z-20 w-[340px] sm:w-[380px] max-w-[90vw] bg-[#111620]/95 backdrop-blur-xl border border-white/15 rounded-3xl p-4 shadow-2xl transition-all duration-300 transform translate-y-0 opacity-100 max-h-[82vh] overflow-y-auto custom-scrollbar"
  >
    <button id="btn-close-poi-card" class="absolute top-3 right-3 w-6 h-6 rounded-full bg-black/60 hover:bg-black/90 text-slate-400 hover:text-white flex items-center justify-center transition-all z-10 text-xs">✕</button>

    <!-- Image -->
    <div class="relative h-28 rounded-2xl overflow-hidden mb-3 border border-white/10">
      <img id="poi-card-image" src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop&q=80" alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/15 to-transparent"></div>
      <span id="poi-card-badge" class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-lg bg-emerald-500 text-obsidian font-black text-xs shadow-md">Día 1</span>
      <div class="absolute bottom-2 left-2.5 right-2.5 flex items-center gap-2 text-[10.5px] font-semibold text-white">
        <span id="poi-card-duration" class="bg-black/60 backdrop-blur-md px-1.5 py-0.5 rounded-md border border-white/10">⏱️ 6 h</span>
        <span id="poi-card-distance" class="bg-black/60 backdrop-blur-md px-1.5 py-0.5 rounded-md border border-white/10">📏 17,4 km</span>
        <span id="poi-card-elevation" class="bg-black/60 backdrop-blur-md px-1.5 py-0.5 rounded-md border border-white/10 text-emerald-300">⛰️ +980 m</span>
      </div>
    </div>

    <!-- Title & Subtitle -->
    <h3 id="poi-card-title" class="text-base font-bold text-white leading-tight">Panticosa / Ibón de Sabocos</h3>
    <p id="poi-card-subtitle" class="text-xs text-emerald-400 font-medium mb-2">Valle de Tena · Rincón del Verde & Ibón de Sabocos</p>
    <p id="poi-card-desc" class="text-[11px] text-slate-300 leading-relaxed mb-3 line-clamp-2">Sube por La Ripera, pasa por el Refugio del Verde y llega al lago glaciar del Ibón de Sabocos.</p>

    <!-- Refugio Highlight Box -->
    <div id="poi-card-refugio-box" class="p-2.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 mb-2.5 text-xs">
      <div class="flex items-center justify-between font-bold text-emerald-300 mb-0.5">
        <div class="flex items-center gap-1.5">
          <span class="text-sm">🛖</span>
          <span id="poi-card-refugio-name">Refugio del Verde</span>
        </div>
        <span id="poi-card-refugio-alt" class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20">2.050 m</span>
      </div>
      <p id="poi-card-refugio-services" class="text-[10.5px] text-slate-300 leading-snug">Refugio libre en ruta, fuente de agua, alojamiento en Panticosa</p>
    </div>

    <!-- Wikiloc Track Box -->
    <div id="poi-card-wikiloc-box" class="p-2.5 rounded-xl bg-emerald-950/40 border border-emerald-500/30 mb-3 text-xs">
      <div class="flex items-center justify-between mb-1">
        <span class="text-[10.5px] font-bold text-emerald-400 flex items-center gap-1">
          <span>🟢</span> Wikiloc Oficial
        </span>
        <span id="poi-card-wikiloc-rating" class="text-[10px] text-amber-300 font-semibold">⭐⭐⭐⭐⭐ 4.9</span>
      </div>
      <p id="poi-card-wikiloc-title" class="text-[11px] font-semibold text-white leading-snug mb-1.5 truncate">
        Panticosa ➔ Rincón del Verde ➔ Ibón de Sabocos
      </p>
      <div class="flex items-center justify-between pt-1">
        <a 
          id="poi-card-wikiloc-link" 
          href="#" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[10.5px] font-bold text-emerald-300 hover:text-white transition-colors"
        >
          <span>Abrir track GPS</span>
          <span>↗️</span>
        </a>
        <button 
          id="btn-toggle-embed" 
          class="text-[10px] font-bold text-slate-300 hover:text-white px-2 py-0.5 rounded bg-white/10 hover:bg-white/20 transition-all"
        >
          🗺️ Ver Mapa Wikiloc
        </button>
      </div>

      <!-- Optional embedded Wikiloc frame -->
      <div id="wikiloc-embed-container" class="hidden mt-2 pt-2 border-t border-white/10">
        <iframe 
          id="wikiloc-iframe" 
          src="" 
          class="w-full h-56 rounded-lg border border-white/10" 
          loading="lazy"
        ></iframe>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2 pt-2 border-t border-white/10">
      <button id="btn-poi-center" class="flex-1 py-1.5 px-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-obsidian font-bold text-xs flex items-center justify-center gap-1 shadow-md active:scale-95 transition-all">
        📍 Centrar
      </button>
      <a id="btn-poi-booking" href="#" target="_blank" rel="noopener noreferrer" class="py-1.5 px-3 rounded-xl bg-white/10 hover:bg-white/15 text-slate-200 font-semibold text-xs flex items-center justify-center gap-1 border border-white/10 transition-all">
        🛖 Más info refugio
      </a>
    </div>
  </div>
</div>

<!-- Leaflet CSS & JS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script is:inline define:vars={{ TRIP_DAYS, MAP_PINS, REFUGIO_PINS }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Vista general centrada en los Pirineos oscenses
    const panoramicCenter = [42.6650, 0.1100];
    const panoramicZoom = 10;

    const map = L.map('full-trip-map', {
      center: panoramicCenter,
      zoom: panoramicZoom,
      zoomControl: false,
      attributionControl: false
    });

    L.control.zoom({ position: 'topright' }).addTo(map);

    // Capa satelital ESRI
    const esriSatellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
      maxZoom: 19
    }).addTo(map);

    const openTopo = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', { maxZoom: 17 });

    let currentLayer = 'satellite';
    document.getElementById('btn-toggle-layer')?.addEventListener('click', function() {
      if (currentLayer === 'satellite') {
        map.removeLayer(esriSatellite);
        map.addLayer(openTopo);
        currentLayer = 'topo';
        this.innerHTML = '🗺️ Topo';
      } else {
        map.removeLayer(openTopo);
        map.addLayer(esriSatellite);
        currentLayer = 'satellite';
        this.innerHTML = '🛰️ Satélite';
      }
    });

    // ─── LÍNEAS DE CARRETERA (COCHE): LÍNEA ANIMADA CON FLUJO CONTINUO EN EL SENTIDO DE LA MARCHA ───
    const driveCasingLayers = {};
    const driveFlowLayers = {};

    TRIP_DAYS.forEach(day => {
      if (!day.drivePath || day.drivePath.length < 2) return;

      // 1. Casing subyacente (asfalto azul profundo)
      const casing = L.polyline(day.drivePath, {
        color: '#0284c7', // Sky-600
        weight: 6,
        opacity: 0.45,
        lineCap: 'round',
        lineJoin: 'round'
      }).addTo(map);
      driveCasingLayers[day.id] = casing;

      // 2. Trazado animado: flujo de guiones que se desplazan hacia el destino
      const flowLine = L.polyline(day.drivePath, {
        className: 'car-route-animated',
        color: '#38bdf8', // Sky-400 / cyan brillante
        weight: 3.5,
        opacity: 0.95,
        lineCap: 'round',
        lineJoin: 'round'
      }).addTo(map);
      driveFlowLayers[day.id] = flowLine;

      flowLine.on('click', () => selectDay(day.id));
      casing.on('click', () => selectDay(day.id));
    });

    // ─── SENDEROS DE MONTAÑA (A PIE): LÍNEAS RESPLANDECIENTES QUE PASAN POR EL REFUGIO ───
    const routeLayers = {};
    const glowLayers = {};

    TRIP_DAYS.forEach(day => {
      if (!day.routePath || day.routePath.length === 0) return;

      // Resplandor
      const glow = L.polyline(day.routePath, {
        color: day.color,
        weight: 12,
        opacity: 0.45,
        lineCap: 'round',
        lineJoin: 'round'
      }).addTo(map);
      glowLayers[day.id] = glow;

      // Trazado a pie principal
      const line = L.polyline(day.routePath, {
        color: day.color,
        weight: 5,
        opacity: 0.95,
        lineCap: 'round',
        lineJoin: 'round'
      }).addTo(map);
      routeLayers[day.id] = line;

      line.on('click', () => selectDay(day.id));
      line.on('mouseover', () => {
        line.setStyle({ weight: 7 });
        glow.setStyle({ opacity: 0.8, weight: 16 });
      });
      line.on('mouseout', () => {
        if (currentActiveDay !== day.id) {
          line.setStyle({ weight: 5 });
          glow.setStyle({ opacity: 0.45, weight: 12 });
        }
      });
    });

    // ─── MARCADORES DE RUTA (NÚMERO SECUENCIAL PROMINENTE + DESTINO COMPACTO) ───
    MAP_PINS.forEach(pin => {
      const pinHtml = `
        <div class="cursor-pointer group select-none transition-all duration-200 hover:scale-110 active:scale-95" style="transform: translate(-50%, -50%)">
          <div style="
            display: inline-flex; align-items: center; gap: 7px;
            padding: 4px 11px 4px 5px; border-radius: 999px;
            background: rgba(15, 20, 30, 0.95);
            border: 1.5px solid ${pin.color};
            backdrop-filter: blur(10px);
            color: white; font-family: Inter, system-ui, sans-serif;
            font-size: 11.5px; font-weight: 800; white-space: nowrap;
            box-shadow: 0 4px 16px rgba(0,0,0,0.8), 0 0 12px ${pin.color}40;
          ">
            <span style="
              width: 20px; height: 20px; border-radius: 50%;
              display: flex; align-items: center; justify-content: center;
              font-size: 11px; font-weight: 900;
              color: #080c12;
              background-color: ${pin.color};
              box-shadow: 0 0 8px ${pin.color};
            ">${pin.badge}</span>
            <span style="color: #f1f5f9; letter-spacing: -0.2px;">${pin.name}</span>
          </div>
        </div>
      `;

      const icon = L.divIcon({
        className: '',
        html: pinHtml,
        iconSize: [0, 0],
        iconAnchor: [0, 0]
      });

      const marker = L.marker(pin.coords, { icon }).addTo(map);
      marker.on('click', () => selectDay(pin.id));
    });

    // ─── MARCADORES DE REFUGIOS: SOLO ICONO 🛖 (SIN TEXTO EN EL MAPA PARA EVITAR SATURACIÓN) ───
    REFUGIO_PINS.forEach(refugio => {
      const refugioHtml = `
        <div class="cursor-pointer group select-none transition-transform hover:scale-125 active:scale-95" style="transform: translate(-50%, -50%)" title="${refugio.name} (${refugio.alt})">
          <div style="
            width: 28px; height: 28px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            background: rgba(5, 46, 22, 0.95);
            border: 2px solid #4ade80;
            box-shadow: 0 0 12px rgba(74, 222, 128, 0.6), 0 4px 10px rgba(0,0,0,0.8);
            font-size: 15px;
          ">
            🛖
          </div>
        </div>
      `;

      const icon = L.divIcon({
        className: '',
        html: refugioHtml,
        iconSize: [0, 0],
        iconAnchor: [0, 0]
      });

      const marker = L.marker(refugio.coords, { icon }).addTo(map);
      marker.on('click', () => selectDay(refugio.id));
    });

    // ─── POI CARD ELEMENTS ───
    const poiCard = document.getElementById('poi-detail-card');
    const els = {
      image: document.getElementById('poi-card-image'),
      badge: document.getElementById('poi-card-badge'),
      title: document.getElementById('poi-card-title'),
      subtitle: document.getElementById('poi-card-subtitle'),
      desc: document.getElementById('poi-card-desc'),
      refugioName: document.getElementById('poi-card-refugio-name'),
      refugioAlt: document.getElementById('poi-card-refugio-alt'),
      refugioServices: document.getElementById('poi-card-refugio-services'),
      wikilocTitle: document.getElementById('poi-card-wikiloc-title'),
      wikilocRating: document.getElementById('poi-card-wikiloc-rating'),
      wikilocLink: document.getElementById('poi-card-wikiloc-link'),
      wikilocIframe: document.getElementById('wikiloc-iframe'),
      wikilocContainer: document.getElementById('wikiloc-embed-container'),
      duration: document.getElementById('poi-card-duration'),
      distance: document.getElementById('poi-card-distance'),
      elevation: document.getElementById('poi-card-elevation'),
      booking: document.getElementById('btn-poi-booking'),
      center: document.getElementById('btn-poi-center')
    };

    let currentActiveDay = 'dia-1';

    function updatePoiCard(day) {
      if (!day || !poiCard) return;
      poiCard.classList.remove('translate-y-full', 'opacity-0');

      els.image.src = day.poi.image;
      els.badge.innerText = `Día ${day.dayNumber}`;
      els.badge.style.backgroundColor = day.color;
      els.title.innerText = day.poi.name;
      els.subtitle.innerText = day.poi.subtitle;
      els.subtitle.style.color = day.color;
      els.desc.innerText = day.poi.description;

      // Refugio
      els.refugioName.innerText = day.refugio.name;
      els.refugioAlt.innerText = day.refugio.altitude;
      els.refugioServices.innerText = day.refugio.services;
      els.booking.href = day.refugio.bookingUrl;

      // Wikiloc
      els.wikilocTitle.innerText = day.wikiloc.title;
      els.wikilocRating.innerText = day.wikiloc.rating;
      els.wikilocLink.href = day.wikiloc.searchUrl;

      if (day.wikiloc.embedUrl) {
        els.wikilocIframe.src = day.wikiloc.embedUrl;
        document.getElementById('btn-toggle-embed').style.display = 'inline-block';
      } else {
        els.wikilocIframe.src = '';
        document.getElementById('btn-toggle-embed').style.display = 'none';
        els.wikilocContainer.classList.add('hidden');
      }

      // Stats
      els.duration.innerText = `⏱️ ${day.poi.duration}`;
      els.distance.innerText = `📏 ${day.poi.distance}`;
      els.elevation.innerText = `⛰️ ${day.poi.elevation}`;
    }

    function selectDay(dayId) {
      if (dayId === 'all') {
        TRIP_DAYS.forEach(d => {
          if (routeLayers[d.id]) {
            routeLayers[d.id].setStyle({ opacity: 0.95, weight: 5 });
            glowLayers[d.id].setStyle({ opacity: 0.45, weight: 12 });
          }
          if (driveFlowLayers[d.id]) {
            driveFlowLayers[d.id].setStyle({ opacity: 0.95, weight: 3.5 });
            driveCasingLayers[d.id].setStyle({ opacity: 0.45, weight: 6 });
          }
        });
        map.flyTo(panoramicCenter, panoramicZoom, { duration: 1.2 });
        return;
      }

      const selected = TRIP_DAYS.find(d => d.id === dayId);
      if (!selected) return;

      currentActiveDay = dayId;
      updatePoiCard(selected);

      // Resaltar ruta activa y atenuar las demás
      TRIP_DAYS.forEach(d => {
        if (d.id === dayId) {
          if (routeLayers[d.id]) routeLayers[d.id].setStyle({ opacity: 1, weight: 7 });
          if (glowLayers[d.id]) glowLayers[d.id].setStyle({ opacity: 0.85, weight: 16 });
          if (driveFlowLayers[d.id]) driveFlowLayers[d.id].setStyle({ opacity: 1, weight: 5 });
          if (driveCasingLayers[d.id]) driveCasingLayers[d.id].setStyle({ opacity: 0.8, weight: 9 });
        } else {
          if (routeLayers[d.id]) routeLayers[d.id].setStyle({ opacity: 0.2, weight: 2.5 });
          if (glowLayers[d.id]) glowLayers[d.id].setStyle({ opacity: 0.05 });
          if (driveFlowLayers[d.id]) driveFlowLayers[d.id].setStyle({ opacity: 0.2, weight: 2.5 });
          if (driveCasingLayers[d.id]) driveCasingLayers[d.id].setStyle({ opacity: 0.15, weight: 4 });
        }
      });

      // Encuadrar en el sendero del día incluyendo el refugio
      if (selected.routePath && selected.routePath.length > 0) {
        const bounds = L.latLngBounds(selected.routePath);
        map.flyToBounds(bounds, { padding: [70, 70], maxZoom: 13, duration: 1.2 });
      } else {
        map.flyTo(selected.poi.coords, 12, { duration: 1.2 });
      }
    }

    // Toggle embed
    document.getElementById('btn-toggle-embed')?.addEventListener('click', () => {
      els.wikilocContainer.classList.toggle('hidden');
    });

    // Recenter
    document.getElementById('btn-recenter-map')?.addEventListener('click', () => selectDay('all'));

    // Close POI card
    document.getElementById('btn-close-poi-card')?.addEventListener('click', () => {
      poiCard.classList.add('translate-y-full', 'opacity-0');
    });

    // Center button
    els.center?.addEventListener('click', () => selectDay(currentActiveDay));

    // Global events
    window.addEventListener('select-day', (e) => selectDay(e.detail.dayId));
    window.addEventListener('resize', () => map.invalidateSize());
    window.addEventListener('drawer-toggle', () => setTimeout(() => map.invalidateSize(), 320));

    // Inicial
    updatePoiCard(TRIP_DAYS[0]);
  });
</script>

<style is:global>
  /* Animación continua de flujo en carretera (dirección de la ruta) */
  @keyframes flowCarLine {
    from {
      stroke-dashoffset: 22;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .car-route-animated {
    stroke-dasharray: 8 14 !important;
    animation: flowCarLine 1.2s linear infinite !important;
    cursor: pointer;
  }

  .car-route-animated:hover {
    filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.9));
  }
</style>
