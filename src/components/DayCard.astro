---
// DayCard.astro
import type { DayPlan } from '../data/tripData';

interface Props {
  day: DayPlan;
}

const { day } = Astro.props;

const difficultyColors = {
  'Fácil': 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30',
  'Moderada': 'bg-cyan-500/20 text-cyan-400 border-cyan-500/30',
  'Exigente': 'bg-orange-500/20 text-orange-400 border-orange-500/30'
};
---

<div id={day.id} class="group rounded-3xl bg-surface/80 backdrop-blur-xl border border-white/10 hover:border-white/20 transition-all duration-300 p-6 sm:p-8 flex flex-col justify-between shadow-xl relative overflow-hidden">
  
  <!-- Subtle accent gradient highlight -->
  <div 
    class="absolute top-0 right-0 w-72 h-72 rounded-full blur-[100px] pointer-events-none opacity-15"
    style={`background: ${day.color};`}
  ></div>

  <!-- Header -->
  <div>
    <div class="flex flex-wrap items-center justify-between gap-2.5 mb-4">
      <div class="flex items-center gap-2">
        <span 
          class="w-8 h-8 rounded-2xl flex items-center justify-center font-black text-sm text-obsidian shadow-lg"
          style={`background: ${day.color};`}
        >
          {day.dayNumber}
        </span>
        <span class="text-xs uppercase tracking-widest font-semibold text-slate-400">
          {day.date}
        </span>
      </div>

      <div class="flex items-center gap-2">
        <span class={`text-[11px] font-semibold px-2.5 py-0.5 rounded-full border ${difficultyColors[day.difficulty]}`}>
          {day.difficulty}
        </span>
        <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-white/10 text-white border border-white/10">
          {day.tag}
        </span>
      </div>
    </div>

    <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight mb-2 group-hover:text-accent transition-colors">
      {day.title}
    </h3>

    <p class="text-sm text-slate-300 leading-relaxed mb-6">
      {day.summary}
    </p>

    <!-- Metrics Bento Strip -->
    <div class="grid grid-cols-3 gap-2.5 p-3 rounded-2xl bg-surface-elevated/80 border border-white/5 mb-6 text-center">
      <div>
        <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">Distancia</span>
        <span class="text-sm font-extrabold text-white">{day.distance}</span>
      </div>
      <div class="border-x border-white/10">
        <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">Desnivel</span>
        <span class="text-sm font-extrabold text-white">{day.elevationGain}</span>
      </div>
      <div>
        <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">Duración</span>
        <span class="text-sm font-extrabold text-white">{day.duration}</span>
      </div>
    </div>

    <!-- Highlights -->
    <div class="mb-6">
      <h4 class="text-xs uppercase tracking-wider font-bold text-slate-400 mb-2.5 flex items-center gap-1.5">
        <span>✨</span> Hitos imprescindibles
      </h4>
      <ul class="space-y-1.5 text-xs text-slate-300">
        {day.highlights.map(item => (
          <li class="flex items-start gap-2">
            <span class="text-accent mt-0.5">›</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Timeline Accordion Details -->
    <details class="group/timeline mb-6 rounded-2xl bg-black/30 border border-white/5 p-4 text-xs transition-colors">
      <summary class="cursor-pointer font-bold text-slate-300 flex items-center justify-between select-none list-none">
        <span class="flex items-center gap-2">
          <span>⏱️</span> Ver Horario Estimado Día a Día
        </span>
        <span class="text-slate-500 group-open/timeline:rotate-180 transition-transform">▼</span>
      </summary>

      <div class="mt-4 pt-3 border-t border-white/10 space-y-3">
        {day.schedule.map(slot => (
          <div class="flex items-start gap-3">
            <span class="font-mono text-accent font-semibold w-12 shrink-0">{slot.time}</span>
            <span class="text-slate-300">{slot.activity}</span>
          </div>
        ))}
      </div>
    </details>

    <!-- Tips & Warnings -->
    {day.keyTips.length > 0 && (
      <div class="p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-200/90 mb-6">
        <div class="font-bold flex items-center gap-1.5 mb-1.5 text-amber-300">
          <span>💡</span> Consejos Clave
        </div>
        <ul class="space-y-1">
          {day.keyTips.map(tip => (
            <li>• {tip}</li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Footer Actions -->
  <div class="pt-4 border-t border-white/10 flex items-center justify-between gap-3">
    <div class="text-[11px] text-slate-400 truncate max-w-[200px] sm:max-w-xs">
      🚗 {day.carTravel}
    </div>

    <button 
      type="button" 
      onclick={`window.jumpToMapDay('${day.id}')`}
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold border border-white/15 transition-all active:scale-95"
    >
      <span>🗺️</span>
      <span>Ver en Mapa</span>
    </button>
  </div>
</div>
